<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1">
<title>Coin Exchange — Demo</title>
<style>
*{box-sizing:border-box} body{margin:0;font-family:Arial,sans-serif;background:#111;color:#fff;min-height:100vh;display:flex;align-items:center;justify-content:center}
.phone{width:min(100%,430px);min-height:100vh;background:#f7f7f7;color:#222;padding:24px 18px;position:relative}
.badge{background:#ffe7e7;color:#c62828;font-weight:800;text-align:center;padding:9px;border-radius:10px;margin-bottom:18px}
h1{font-size:25px;margin:10px 0}.balance{font-size:34px;font-weight:800;margin:8px 0}.muted{color:#777;font-size:13px}
.card{background:#fff;border-radius:16px;padding:18px;box-shadow:0 4px 20px #0001;margin-top:18px}
label{display:block;font-size:13px;color:#666;margin:15px 0 7px}
input{width:100%;padding:14px;border:1px solid #ddd;border-radius:11px;font-size:16px}
.row{display:grid;grid-template-columns:1fr 1fr;gap:9px}.amt{padding:13px;border:1px solid #ddd;background:#fff;border-radius:10px;font-weight:700}
.amt.active{border:2px solid #16c60c}.primary{width:100%;padding:15px;border:0;border-radius:12px;background:#20d51b;color:#fff;font-size:17px;font-weight:800;margin-top:18px}
.note{font-size:12px;color:#777;line-height:1.4;margin-top:14px}
.hidden{display:none}.success{text-align:center;padding-top:55px}.check{width:74px;height:74px;border-radius:50%;background:#20d51b;color:#fff;font-size:45px;line-height:74px;margin:auto}
.result{background:#fff;border-radius:15px;padding:18px;margin-top:25px}.line{display:flex;justify-content:space-between;padding:11px 0;border-bottom:1px solid #eee}.line:last-child{border:0}
.back{width:100%;padding:14px;border:0;border-radius:12px;background:#eee;font-size:16px;margin-top:18px}
</style>
</head>
<body>
<div class="phone">
  <div class="badge"</div>

  <section id="exchange">
    <div class="muted">Coin Exchange</div>
    <h1>Обмен монет</h1>
    <div class="balance">$5,917,675.22</div>
    <div class="muted"></div>

    <div class="card">
      <label>TikTok username</label>
      <input id="user" value="@demo_user" autocomplete="off">

      <label>Количество монет</label>
      <div class="row">
        <button class="amt" onclick="setAmount(10000)">10 000</button>
        <button class="amt" onclick="setAmount(100000)">100 000</button>
        <button class="amt" onclick="setAmount(1000000)">1 000 000</button>
        <button class="amt" onclick="setAmount(2000000)">2 000 000</button>
      </div>

      <label>Своя сумма</label>
      <input id="coins" type="number" value="2000000" min="1">

      <button class="primary" onclick="exchange()">Exchange</button>
      <div class="note">Это автономный HTML-макет для демонстрации интерфейса. Он не подключён к TikTok, не отправляет монеты и не переводит реальные деньги.</div>
    </div>
  </section>

  <section id="success" class="hidden success">
    <div class="check">✓</div>
    <h1>Exchange Completed!</h1>
    <div class="muted">Демонстрационная операция</div>
    <div class="result">
      <div class="line"><span>Получатель</span><b id="outUser">@demo_user</b></div>
      <div class="line"><span>Coins Exchanged</span><b id="outCoins">2,000,000</b></div>
      <div class="line"><span>Статус</span><b>DEMO</b></div>
    </div>
    <button class="back" onclick="back()">← Go back</button>
  </section>
</div>

<script>
function setAmount(n){
  document.getElementById('coins').value=n;
}
function exchange(){
  const u=document.getElementById('user').value || '@demo_user';
  const n=Number(document.getElementById('coins').value||0);
  if(n<1){alert('Введите количество монет');return}
  document.getElementById('outUser').textContent=u;
  document.getElementById('outCoins').textContent=n.toLocaleString('en-US')+' Coins';
  document.getElementById('exchange').classList.add('hidden');
  document.getElementById('success').classList.remove('hidden');
}
function back(){
  document.getElementById('success').classList.add('hidden');
  document.getElementById('exchange').classList.remove('hidden');
}
</script>
</body>
</html>
